{
  "schema": 1,
  "scope": "所有 NAS 应用按需只读访问 data；仅约束各路径的唯一常规写入者，不限制宿主机管理员",
  "readers": [
    "meta",
    "tailscale",
    "files",
    "smb",
    "knowledge",
    "git",
    "syncthing",
    "immich-server",
    "immich-machine-learning",
    "database",
    "cache",
    "backup",
    "joplin"
  ],
  "rules": [
    {
      "path": ".",
      "writer": null,
      "readers": [],
      "purpose": "目录规则入口；未分配路径没有应用写入者"
    },
    {
      "path": "immich",
      "writer": "immich-server",
      "readers": [],
      "purpose": "照片原件、上传、缩略图、转码与相册导出"
    },
    {
      "path": "git",
      "writer": "git",
      "readers": [],
      "purpose": "Git 裸仓库；通过 SSH 推送与拉取"
    },
    {
      "path": "knowledge",
      "writer": "administrator",
      "readers": [
        "knowledge"
      ],
      "purpose": "保留的旧 Markdown 与附件；不再作为网页写作入口"
    },
    {
      "path": "shared",
      "writer": "syncthing",
      "readers": [],
      "purpose": "多设备完整同步；Syncthing 统一维护普通文件、历史版本和目录标记",
      "maintenance": {
        "writer": "restore",
        "condition": "仅历史恢复：取得生命周期锁并暂停 NAS 共享后生成新副本"
      }
    },
    {
      "path": "joplin",
      "writer": "joplin",
      "readers": [],
      "purpose": "Joplin 管理的笔记、图片与附件载荷；通过客户端同步，不直接编辑内部文件"
    }
  ]
}
